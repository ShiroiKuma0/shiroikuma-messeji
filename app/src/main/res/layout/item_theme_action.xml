<?xml version="1.0" encoding="utf-8"?>
<!-- An action / navigation row of the UI page: an outlined pill that hugs its label (with a › when it
     opens something), and its explanation beneath, aligned with the label text. The pill alone is the
     touch target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/theme_action_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="3dp"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingBottom="3dp"
    tools:ignore="RtlSymmetry">

    <LinearLayout
        android:id="@+id/theme_action_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="9dp"
        android:paddingEnd="16dp"
        android:paddingBottom="9dp">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/theme_action_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/bigger_text_size"
            tools:text="Export / Import…" />

        <TextView
            android:id="@+id/theme_action_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:importantForAccessibility="no"
            android:text="›"
            android:textSize="@dimen/bigger_text_size"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <org.fossify.commons.views.MyTextView
        android:id="@+id/theme_action_description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:textSize="13sp"
        tools:text="Last export: today" />
</LinearLayout>
