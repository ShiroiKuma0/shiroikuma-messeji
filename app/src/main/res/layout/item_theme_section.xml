<?xml version="1.0" encoding="utf-8"?>
<!-- kxkb-style section header: a full-width 1px hairline above the group (hidden on the first
     section), then a big bold heading with a text-wide underline. The underline is match_parent
     inside a wrap_content parent, so it resolves to exactly the heading-text width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/theme_section_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp"
    tools:ignore="MissingDefaultResource,PxUsage">

    <View
        android:id="@+id/theme_section_separator"
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="8dp"
        tools:ignore="RtlSymmetry">

        <TextView
            android:id="@+id/theme_section_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/theme_section_divider"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
