<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: the day heading of a conversation — a thin full-width divider, then the date in bold with
     a text-wide underline, left-aligned like the sub-headings of the UI page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/thread_date_time_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <View
        android:id="@+id/thread_day_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/thread_date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="13 March" />

        <View
            android:id="@+id/thread_day_underline"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
