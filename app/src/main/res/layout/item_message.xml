<?xml version="1.0" encoding="utf-8"?>
<!-- Fork: a framed bubble with the sender's picture half in, half out on its side edge, and the
     footer (SIM badge, time, delivery status) inside the frame. ThreadAdapter sets side, margins,
     paddings and the frame per message. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/thread_message_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:clipToPadding="false"
    android:paddingHorizontal="6dp">

    <LinearLayout
        android:id="@+id/thread_message_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="vertical"
        android:paddingStart="38dp"
        android:paddingTop="11dp"
        android:paddingEnd="16dp"
        android:paddingBottom="11dp">

        <FrameLayout
            android:id="@+id/thread_message_attachments_frame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/thread_message_attachments_holder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:divider="@drawable/linear_layout_vertical_divider"
                android:orientation="vertical"
                android:showDividers="middle" />

            <ImageView
                android:id="@+id/thread_message_play_outline"
                android:layout_width="@dimen/play_outline_size"
                android:layout_height="@dimen/play_outline_size"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="@dimen/medium_margin"
                android:layout_marginBottom="@dimen/activity_margin"
                android:src="@drawable/ic_play_outline_vector"
                android:visibility="gone"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <org.fossify.commons.views.MyTextView
            android:id="@+id/thread_message_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:autoLink="email|web"
            android:textSize="@dimen/normal_text_size"
            tools:text="Message content" />

        <LinearLayout
            android:id="@+id/thread_message_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/thread_sim_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/thread_sim_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/thread_sim_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:maxLines="1"
                    tools:text="1" />
            </FrameLayout>

            <TextView
                android:id="@+id/thread_message_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                tools:text="13:30" />

            <ImageView
                android:id="@+id/thread_message_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:ignore="ContentDescription" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/thread_message_sender_photo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginTop="4dp"
        android:padding="5dp"
        android:src="@drawable/ic_unknown_contact"
        tools:ignore="ContentDescription" />
</FrameLayout>
